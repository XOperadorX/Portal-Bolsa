{
  "name": "MM Quase Tudo — Central de Jogos",
  "short_name": "MMQuaseTudo",
  "displayName": "MM Quase Tudo",
  "version": "1.0.0",
  "description": "Central de jogos, economia virtual e negociações entre jogadores",
  "start_url": "./index.html",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0b10",
  "theme_color": "#002bad",
  "lang": "pt-BR",
  "icons": [
    { "src": "./assets/favicon-32.png",  "sizes": "32x32",   "type": "image/png" },
    { "src": "./assets/favicon-16.png",  "sizes": "16x16",   "type": "image/png" },
    { "src": "./assets/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ],
  "main": "index.js",
  "scripts": {
    "dev": "npx serve . -l 3000",
    "preview": "npx serve .",
    "prepare": "cordova prepare",
    "build:android": "cordova build android --release",
    "build:ios": "cordova build ios --release",
    "run:android": "cordova run android",
    "clean": "rm -rf platforms plugins www node_modules",
    "lint": "npx eslint . --ext .js,.html",
    "format": "npx prettier --write ."
  },
  "keywords": ["ecosystem:cordova", "mmorpg", "browser-game"],
  "author": "Equipe MM Quase Tudo",
  "license": "Apache-2.0",
  "cordova": {
    "plugins": {
      "cordova-plugin-whitelist": {},
      "cordova-plugin-inappbrowser": {},
      "cordova-plugin-statusbar": {},
      "cordova-plugin-device": {}
    },
    "platforms": ["android", "ios"]
  },
  "devDependencies": {
    "cordova-android": "^12.0.0",
    "cordova-ios": "^7.0.0",
    "cordova-plugin-whitelist": "^1.3.5",
    "cordova-plugin-inappbrowser": "^5.0.0",
    "cordova-plugin-statusbar": "^3.0.0",
    "cordova-plugin-device": "^2.1.0"
  }
}